{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "zeux",
  "version": "0.1.0",
  "identifier": "com.zeux.app",
  "build": {
    "beforeDevCommand": "npm run build:daemon && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:daemon && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ZeuX",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/zeuxd"],
    "resources": ["resources/"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": false
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libayatana-appindicator3-1",
          "librsvg2-2"
        ]
      },
      "rpm": {
        "depends": [
          "libappindicator-gtk3",
          "librsvg2"
        ]
      }
    }
  }
}
