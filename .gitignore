# Binários compilados
/zeuxd
/zeuxd.exe
/bin/
/dist/

# Dependências do frontend (Fase 2)
node_modules/

# Artefatos de build do Tauri (Fase 2)
src-tauri/target/

# zeuxd compilado como sidecar do Tauri (scripts/build-zeuxd.mjs); é gerado a
# cada build, por plataforma — não faz sentido versionar.
src-tauri/binaries/

# Cores do RetroArch baixados do buildbot.libretro.com
# (scripts/download-retroarch-cores.mjs, ADR 0012). São binários grandes
# (.so/.dll/.dylib) baixados a cada build, um por plataforma — mesmo motivo
# de não versionar src-tauri/binaries/. O .gitkeep mantém a pasta vazia no
# clone, pro script ter onde escrever.
src-tauri/resources/retroarch/cores/*
!src-tauri/resources/retroarch/cores/.gitkeep

# App do RetroArch em si, baixado do buildbot por cmd/download-retroarch-app
# (extensão do ADR 0012, 2026-08-04) — mesmo motivo dos cores acima: binário
# grande, baixado a cada build, um por plataforma.
src-tauri/resources/retroarch/bin/*
!src-tauri/resources/retroarch/bin/.gitkeep

# Cache e configuração local de ferramentas
.mise.local.toml
*.local

# Sistema operacional
Thumbs.db
.DS_Store
